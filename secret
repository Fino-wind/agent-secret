#!/usr/bin/env bash
#
# secret — a tiny secret manager for AI agents, backed by the macOS Keychain.
#
#   secret set <name>   Pop a native (hidden) GUI prompt, store the value in Keychain.
#   secret get <name>   Print the value to stdout — for `$(secret get <name>)` injection.
#   secret list         List stored secret NAMES only (values are never shown).
#   secret rm <name>    Delete a secret.
#
# The value never touches the chat, a plaintext file, or the agent's context:
# the human types it into the GUI box, it lives only in the login Keychain, and
# the agent injects it with $(secret get <name>) without ever printing it.
#
set -euo pipefail

SERVICE_PREFIX="agent.secret"
INDEX_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/agent-secret"
INDEX_FILE="$INDEX_DIR/names"

usage() {
  sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

require_name() {
  [ -n "${name:-}" ] || { echo "usage: secret $cmd <name>" >&2; exit 2; }
  case "$name" in
    *[!a-zA-Z0-9_.-]*) echo "name must match [a-zA-Z0-9_.-]" >&2; exit 2 ;;
  esac
}

cmd="${1:-}"
name="${2:-}"

case "$cmd" in
  set)
    require_name
    value=$(
      osascript \
        -e "display dialog \"Enter the secret value for:  $name\" with title \"Agent Secret Manager\" default answer \"\" with hidden answer buttons {\"Cancel\", \"Save\"} default button \"Save\"" \
        -e "text returned of result" 2>/dev/null
    ) || { echo "cancelled" >&2; exit 1; }
    [ -n "$value" ] || { echo "empty value — nothing stored" >&2; exit 1; }
    security add-generic-password -U -a "$USER" -s "${SERVICE_PREFIX}.${name}" -w "$value" >/dev/null
    mkdir -p "$INDEX_DIR"
    { [ -f "$INDEX_FILE" ] && cat "$INDEX_FILE"; printf '%s\n' "$name"; } | sort -u > "$INDEX_FILE.tmp"
    mv "$INDEX_FILE.tmp" "$INDEX_FILE"
    echo "stored '$name' in Keychain (value not shown)"
    ;;
  get)
    require_name
    security find-generic-password -a "$USER" -s "${SERVICE_PREFIX}.${name}" -w
    ;;
  list)
    if [ -s "$INDEX_FILE" ]; then cat "$INDEX_FILE"; else echo "(no secrets stored yet)"; fi
    ;;
  rm)
    require_name
    security delete-generic-password -a "$USER" -s "${SERVICE_PREFIX}.${name}" >/dev/null 2>&1 || true
    if [ -f "$INDEX_FILE" ]; then
      grep -vxF "$name" "$INDEX_FILE" > "$INDEX_FILE.tmp" 2>/dev/null || true
      mv "$INDEX_FILE.tmp" "$INDEX_FILE" 2>/dev/null || true
    fi
    echo "removed '$name'"
    ;;
  ""|-h|--help|help)
    usage 0
    ;;
  *)
    echo "unknown command: $cmd" >&2
    usage 2
    ;;
esac
